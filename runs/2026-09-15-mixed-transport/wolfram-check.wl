Module[{f,inv,tr,ph,act,om,ops,im,orb,nxt},f[t_,e_]:=Mod[t^4+6e t^2+1,13];inv[a_]:=If[Mod[a,13]==0,Throw["pole"],PowerMod[a,-1,13]];tr[p_,j_]:=Module[{t=p[[j]],e=If[j==1,1,-1],a,d,h,o=p},a=t(t^8-6t^4-24e t^2-3);d=3t^8+24e t^6+6t^4-1;h=t^16+24e t^14+28t^12+168e t^10+582t^8+168e t^6+28t^4+24e t^2+1;o[[j]]=Mod[a inv[d],13];o[[3]]=Mod[p[[3]]h inv[d]^2,13];o];ph[p_]:=Module[{x=p[[1]],y=p[[2]],w=p[[3]],g,c,k,b,z,h,j,dx,u,v},g=x^2-y^2+6;c=Mod[(x^2 y^2+1)inv[g],13];k=Mod[6c-1,13];b=Mod[c^2+k,13];If[Mod[c k w,13]==0,Throw["singular chart"]];z=Mod[y(x^2+c),13];h=Mod[(4c x^3+2b x)inv[2z],13];j=Mod[(6c x^2+b-h^2)inv[2z],13];dx=Mod[-(4c x-2h j)inv[c-j^2],13];u=Mod[x+dx,13];v=Mod[(z+h dx+j dx^2)inv[u^2+c],13];{u,v,Mod[w(u^2-v^2+6)inv[g],13]}];ops=Range[8];act[p_,j_]:=Switch[j,1,tr[p,1],2,tr[p,2],3,ph[p],4,{inv[p[[1]]],p[[2]],Mod[p[[3]]inv[p[[1]]]^2,13]},5,{p[[1]],inv[p[[2]]],Mod[p[[3]]inv[p[[2]]]^2,13]},6,Mod[p*{-1,1,1},13],7,Mod[p*{1,-1,1},13],8,Mod[p*{1,1,-1},13]];om=Select[Tuples[Range[0,12],3],Function[p,Mod[p[[3]]^2-f[p[[1]],1]f[p[[2]],-1],13]==0&&PowerMod[f[p[[1]],1],6,13]==12&&PowerMod[f[p[[2]],-1],6,13]==12&&Xor[Mod[p[[1]]^2-1,13]==0,Mod[p[[2]]^2+1,13]==0]]];im=Flatten[Map[Function[p,Map[Function[j,act[p,j]],ops]],om],1];orb={{1,11,3}};While[True,nxt=Union[orb,Flatten[Map[Function[p,{tr[p,1],tr[p,2],ph[p]}],orb],1]];If[nxt==Sort[orb],Break[]];orb=nxt];<|"version"->$Version,"omega"->Length[om],"transitions"->Length[im],"closed"->And@@(MemberQ[om,#]&/@im),"orbit"->Length[orb],"nonsquare_values"->And@@(PowerMod[f[#[[1]],1],6,13]==12&/@orb),"scope"->"Exact F13 closure and unit-denominator checks only."|>]
