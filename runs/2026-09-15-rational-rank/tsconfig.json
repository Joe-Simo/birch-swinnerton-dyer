{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "outDir": "dist"
  },
  "include": ["verify.ts", "witnesses.ts"]
}
